<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BgPrimary" Color="#1A1A2E"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#2D2D44"/>
    <SolidColorBrush x:Key="BgTertiary" Color="#25253A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="White"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6C6C8A"/>
    <SolidColorBrush x:Key="Success" Color="#4CAF50"/>
    <SolidColorBrush x:Key="Error" Color="#F44336"/>
    <SolidColorBrush x:Key="Warning" Color="#FF9800"/>
    <SolidColorBrush x:Key="Info" Color="#2196F3"/>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>